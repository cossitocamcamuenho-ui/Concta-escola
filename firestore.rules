rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function isClassMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.members;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'className', 'bio', 'updatedAt']);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames is map;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;
      allow update: if signedIn()
        && (
          (
            request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'updatedAt'])
          )
          ||
          (
            !(request.auth.uid in resource.data.members)
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'updatedAt'])
          )
        );
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isClassMember(classId);
        allow create: if isClassMember(classId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }
  }
}
